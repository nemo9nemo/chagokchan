# TEMPLATE ONLY. Local app foundation is configured; external projects are not.
# Local development uses .env.development.local; do not copy fixture settings to deployments.
# Public OAuth/SMTP callbacks and secrets must be configured per environment.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
APP_POLICY_VERSION=0.2.0

# Development only: no interactive login. NOT allowed in release builds.
# Deployed environments must explicitly set APP_AUTH_MODE=supabase_session.
APP_AUTH_MODE=local_fixture
LOCAL_DEV_ACTOR=A
# Local fixture credentials are generated server-side during local setup.
# Never use a NEXT_PUBLIC_ prefix or production credentials for this mode.

# Ordinary server-side Supabase client; use values for the intended environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only shared request limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public Turnstile widget key and separate server secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Generate separate random values locally and for each deployed environment.
CSRF_SIGNING_SECRET=
RATE_KEY_HMAC_SECRET=

# Supabase management/DB, Vercel deployment, and Resend SMTP credentials
# belong to the relevant admin/CI/Auth settings, not ordinary app runtime.
# Do not add a service-role key to the ordinary app environment.
